{
	"name": "pkce-codes",
	"version": "0.3.1",
	"description": "Create code_verifier and code_challenge values",
	"engines": {
		"node": ">=22.11.0"
	},
	"main": "./lib/pkce.js",
	"module": "./lib/esm/pkce.js",
	"types": "./lib/pkce.d.ts",
	"exports": {
		".": {
			"import": "./lib/esm/pkce.js",
			"require": "./lib/pkce.js",
			"types": "./lib/pkce.d.ts"
		}
	},
	"scripts": {
		"all": "pnpm i && pnpm run format && pnpm run clean && pnpm run build && pnpm run test && pnpm run docs",
		"build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('lib/esm/package.json',JSON.stringify({type:'module'}))\"",
		"build:watch": "tsc --watch",
		"lint": "eslint src/**/*.ts test/**/*.ts",
		"lint:fix": "eslint src/**/*.ts test/**/*.ts --fix",
		"clean": "eslint src/**/*.ts test/**/*.ts --fix",
		"docs": "typedoc --readme none --out docs src/pkce.ts",
		"test": "jest --coverage --config jest.config.js",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"up": "pnpm up -i",
		"upgrade": "pnpm up",
		"latest": "pnpm up -i -L",
		"l": "pnpm i && pnpm run latest"
	},
	"files": [
		"lib/**/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cope/pkce.git"
	},
	"keywords": [
		"pkce"
	],
	"author": "Predrag Stojadinovic",
	"license": "Unlicense",
	"bugs": {
		"url": "https://github.com/cope/pkce/issues"
	},
	"homepage": "https://github.com/cope/pkce#readme",
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.17.0",
		"eslint-plugin-prettier": "^5.5.7",
		"fast-check": "^4.10.2",
		"jest": "^30.5.2",
		"prettier": "^3.9.10",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.4.15",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@12.16.1"
}
